frame.element=header
frame.top=0
frame.bottom=1
frame.left=1
frame.right=1
frame.expansion=0
text.normal.color=#edf6ff
text.focus.color=#58b4ef
text.press.color=#edf6ff
text.toggle.color=#edf6ff
indicator.element=harrow

[SizeGrip]
