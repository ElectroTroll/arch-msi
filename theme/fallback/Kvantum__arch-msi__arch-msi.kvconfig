# arch-msi.kvconfig - PLANTILLA del tema de Kvantum (arch-msi)
#
# Fuente: dotfiles/matugen/.config/matugen/templates/kvantum-theme.kvconfig
# Salida: ~/.config/Kvantum/arch-msi/arch-msi.kvconfig          (artefacto)
#
# ORIGEN Y LICENCIA - ADAPTADO DE HyDE. Es su tema `wallbash`
# (https://github.com/Hyde-project/hyde, GPL-3.0), traido el 2026-09-16. Va en
# pareja con kvantum-theme.svg: sus secciones nombran elementos de ESE dibujo,
# asi que los dos archivos no se separan.
#
# Los colores son los nuestros: los nueve marcadores wallbash del original se
# sustituyeron por variables de matugen, con el mismo mapeo que el SVG.
#
# CAMBIO PROPIO SOBRE EL ORIGINAL, uno solo y anotado:
#   transparent_dolphin_view=false - con la vista transparente, Dolphin pinta
#   las filas alternas y la lista sale A RAYAS en vez de translucida. La
#   transparencia la pone Hyprland sobre la ventana entera ([opacity] en
#   tokens.toml). Probado el 2026-09-16.
#
# ⚠️ NO EDITAR la salida: la reescribe matugen. Y no abrir `kvantummanager`,
# que escribe justo ahi.

[%General]
author=prasanth rangan
comment=wallbash
spread_menuitems=true
left_tabs=true
mirror_doc_tabs=true
scroll_width=8
attach_active_tab=true
composite=true
menu_shadow_depth=7
tooltip_shadow_depth=0
splitter_width=7
check_size=16
slider_width=4
slider_handle_width=18
slider_handle_length=18
textless_progressbar=false
menubar_mouse_tracking=true
slim_toolbars=false
toolbutton_style=1
x11drag=menubar_and_primary_toolbar
double_click=false
translucent_windows=false
blurring=false
popup_blurring=true
opaque=kaffeine,kmplayer,subtitlecomposer,kdenlive,vlc,smplayer,smplayer2,avidemux,avidemux2_qt4,avidemux3_qt4,avidemux3_qt5,kamoso,QtCreator,VirtualBox,VirtualBoxVM,trojita,dragon,digikam,lyx
group_toolbar_buttons=false
vertical_spin_indicators=false
fill_rubberband=false
spread_progressbar=true
merge_menubar_with_toolbar=true
small_icon_size=16
large_icon_size=32
button_icon_size=16
scroll_arrows=false
iconless_pushbutton=true
toolbar_icon_size=16
combo_as_lineedit=true
button_contents_shift=false
groupbox_top_label=true
inline_spin_indicators=true
joined_inactive_tabs=false
layout_spacing=2
submenu_overlap=0
tooltip_delay=-1
animate_states=true
transient_scrollbar=true
alt_mnemonic=true
combo_menu=true
layout_margin=4
no_window_pattern=false
respect_DE=true
scroll_min_extent=36
scrollable_menu=false
scrollbar_in_view=false
spin_button_width=16
submenu_delay=250
tree_branch_line=true
progressbar_thickness=8
click_behavior=0
contrast=1.00
dialog_button_layout=0
drag_from_buttons=false
hide_combo_checkboxes=false
intensity=1.00
no_inactiveness=false
reduce_menu_opacity=0
# ⚠️ EL ORIGINAL TRAE 10 Y AQUÍ VA 0. Kvantum resta ese porcentaje de opacidad
# a la ventana por su cuenta, y en este equipo eso se SUMA al 0.92 que ya
# aplica Hyprland: Dolphin quedaba casi invisible, con el wallpaper viéndose
# entero a través. La transparencia se decide en un solo sitio, [opacity] de
# tokens.toml, y ese sitio no es este.
reduce_window_opacity=0
saturation=1.00
shadowless_popup=true
transient_groove=false
menu_blur_radius=6
tooltip_blur_radius=6

[GeneralColors]
window.color=#0c141b
# ⚠️ EL FONDO DE LAS VISTAS ES EL MÁS OSCURO DE LA ESCALA, a propósito.
# El 2026-09-16 se probó a subirlo a `surface_container` para disimular el
# rayado alterno que pinta Dolphin: las bandas pasaron de 23 a 5 puntos de
# diferencia, pero SEGUÍAN viéndose y toda la lista quedaba de un gris opaco.
# No compensaba, y se revirtió. El rayado sigue sin tener solución por
# configuración; ver §33.
base.color=#040b11
alt.base.color=#040b11
# ⚠️ IGUAL QUE `base.color`, Y AQUÍ ESTÁ LA CLAVE DEL RAYADO DE DOLPHIN.
# Kvantum pinta el fondo ALTERNO de las listas con el color de BOTÓN, no con
# `alt.base.color` —que se puede poner en rojo chillón sin que pase nada,
# probado el 2026-09-16, igual que `[Colors:View] BackgroundAlternate` de
# kdeglobals—. La sonda que lo destapó fue poner ESTE valor en rojo: las filas
# alternas salieron rojas. Igualándolo al fondo de la vista, la lista queda
# uniforme. Los botones se siguen distinguiendo por su marco del SVG.
button.color=#040b11
light.color=#283037
mid.light.color=#283037
dark.color=#040b11
mid.color=#040b11
# ⚠️ CON ALFA: #CC son 204/255, o sea 80 % de opacidad. Kvantum lee el color
# en formato #AARRGGBB —alfa PRIMERO, como en Qt—, así que la selección deja
# ver un poco la fila de debajo en vez de ser un bloque macizo. El tono es el
# acento del escritorio, el mismo que el borde de la ventana activa.
highlight.color=#D9007eb6
inactive.highlight.color=#58b4ef
text.color=#edf6ff
window.text.color=#edf6ff
button.text.color=#edf6ff
disabled.text.color=#98a1a9
tooltip.text.color=#edf6ff
highlight.text.color=#040b11
link.color=#58b4ef
link.visited.color=#bac4fa

[ItemView]
# ⚠️ SIN `inherits`, Y ESA ES LA GRACIA. El SVG solo define `itemview-focused`:
# el item NORMAL no existe como dibujo. Heredando de PanelButtonCommand, Kvantum
# pintaba el item normal con el fondo de BOTÓN —más claro que la vista— y solo
# en las filas alternas: de ahí las bandas. Sin herencia no tiene con qué pintar
# el normal (queda del color de la vista, uniforme) y sigue pintando el
# seleccionado, que sí existe en el SVG y lleva el acento.
frame.element=itemview
interior.element=itemview
frame=true
interior=true
text.iconspacing=3
text.normal.color=#edf6ff
text.focused.color=#002337
text.toggled.color=#002337

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox

[TreeExpander]
indicator.element=tree
indicator.size=8

[ToolTip]
frame.top=4
frame.right=4
frame.bottom=4
frame.left=4
frame=true

[PanelButtonCommand]
inherits=PanelButtonCommand
interior.element=button
frame.element=button
text.normal.color=#edf6ff
text.focus.color=#edf6ff
text.press.color=#040b11
text.toggle.color=#040b11

[PanelButtonTool]
inherits=PanelButtonCommand

[DockTitle]
inherits=PanelButtonCommand
interior=false
frame=false
text.margin.top=5
text.margin.bottom=5
text.margin.left=5
text.margin.right=5
indicator.size=0

[Dock] 
interior.element=toolbar
frame.element=toolbar
frame=true
interior=true

[GroupBox]
inherits=PanelButtonCommand
interior.element=tabframe
interior=true
frame=false

[Focus]
inherits=PanelButtonCommand
frame=true
frame.element=focus
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
frame.patternsize=20

[GenericFrame]
inherits=PanelButtonCommand
